# ─── FastCaptcha ─────────────────────────────────────────────
# Get your free API key at https://fastcaptcha.org/accounts/signup/
FASTCAPTCHA_API_KEY="jljksjllsl-lnslnls"

# ─── Slack ───────────────────────────────────────────────────
# Optional: Slack incoming webhook URL for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── CheckVisaSlots ──────────────────────────────────────────
# Comma-separated list of CVS API keys to rotate through for polling
CVS_API_KEYS=key1,key2,key3

# ─── Monitor Runner ──────────────────────────────────────────
POLL_MIN_SECONDS=60
POLL_MAX_SECONDS=90
ALERT_COOLDOWN_SECONDS=900
ERROR_BACKOFF_SECONDS=40
MONITOR_API_REQUEST_TIMEOUT=15

# ─── Auth ────────────────────────────────────────────────────
WAIT_FOR_WAITING_ROOM_TIMEOUT_MINUTES=60
HUMAN_DELAY_MIN_MS=60
HUMAN_DELAY_MAX_MS=180

# ─── Booking Runner ──────────────────────────────────────────
BOOKING_POLL_INTERVAL=0.01
BOOKING_DEFAULT_MINUTES=60.0
BOOKING_COOLDOWN_SECONDS=3600
BOOKING_GAP_SECONDS=900
ENSURE_ON_PORTAL_TIMEOUT_SECONDS=120

# ─── Polling Runner ──────────────────────────────────────────
POLLING_SHORT_BACKOFF=5

# POLLING_WINDOWS: Comma-separated list of minute ranges (e.g., "26-34,56-4") during which polling is active.
# Polling will only occur within these specified minute windows of each hour.
# Example: POLLING_WINDOWS="0-10,30-40" (polling active from 0-10 and 30-40 minutes past the hour)
POLLING_WINDOWS="26-34,56-4"
